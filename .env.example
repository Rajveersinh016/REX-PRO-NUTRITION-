# REX-PRO NUTRITION — Environment Variables Example
# Duplicate this file to .env.local for local overrides.
# DO NOT commit actual secrets or private keys to source control.

# Application Configuration
VITE_APP_TITLE="Rex-Pro Nutrition"
VITE_APP_URL="https://rex-pro-nutrition.vercel.app"

# Simulated Gateway Settings (Demo Mode Enabled by Default)
VITE_ENABLE_DEMO_MODE=true

# Production API Keys (Leave empty for demo mode)
# VITE_RAZORPAY_KEY_ID=""
# VITE_WHATSAPP_NUMBER="919327708205"
